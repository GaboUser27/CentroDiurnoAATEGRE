@using CentroDiurnoAATEGRE.Application.DTOs
@{
    ViewData["Title"] = "Quiénes Somos";
    ViewData["ActivePage"] = "Quienes";
    var info = ViewBag.Informacion;
    var imagenesCarrusel = ViewBag.ImagenesCarrusel as List<ImagenDTO>;
    var imagenesPresupuesto = ViewBag.ImagenesPresupuesto as List<ImagenDTO>;
}

<div style="background:linear-gradient(135deg,var(--azul-oscuro),var(--azul));padding:5rem 0 4rem;position:relative;overflow:hidden;">
    <div style="position:absolute;bottom:0;left:0;right:0;height:60px;background:white;clip-path:ellipse(55% 100% at 50% 100%);"></div>
    <div class="container text-center position-relative">
        <div class="hero-eyebrow d-inline-flex mb-3">
            <i class="bi bi-people-fill me-2"></i>Nuestra historia
        </div>
        <h1 style="font-family:'Playfair Display',serif;color:white;font-size:clamp(1.8rem,4vw,2.8rem);">
            Quiénes Somos
        </h1>
        <p style="color:rgba(255,255,255,.75);max-width:520px;margin:.75rem auto 0;">
            Conoce la historia, misión y valores de AATEGRE Centro Diurno.
        </p>
    </div>
</div>

<section class="seccion-quienes" style="padding-top:5rem;">
    <div class="container">
        <div class="row align-items-center g-5 mb-5">
            <div class="col-lg-5">
                <img src="~/images/quienes-somos.jpg"
                     class="img-fluid rounded shadow"
                     style="max-width:100%; object-fit: cover;">
            </div>
            <div class="col-lg-7">
                <p class="text-uppercase fw-bold mb-2" style="color:var(--azul);font-size:.85rem;letter-spacing:.1em;">
                    <i class="bi bi-building me-1"></i>El Centro
                </p>
                <h2 class="seccion-titulo">@(info?.Titulo ?? "AATEGRE Centro Diurno")</h2>
                <div class="linea-acento izquierda mb-4"></div>
                <div style="color:var(--texto-suave);font-size:1.05rem;line-height:1.85;">
                    @if (info?.Contenido != null)
                    {
                        @Html.Raw(info.Contenido.Replace("\n", "<br/>"))
                    }
                    else
                    {
                        <p>
                            AATEGRE Centro Diurno es un espacio dedicado al bienestar integral de los adultos mayores de
                            la zona de Grecia, Alajuela.
                        </p>
                        <p class="mt-3">
                            Contamos con un equipo multidisciplinario comprometido con brindar atención médica,
                            recreación, nutrición y acompañamiento emocional en un entorno seguro y cálido.
                        </p>
                    }
                </div>
            </div>
        </div>

        @* ───────── NUESTRA HISTORIA ───────── *@
        <div class="row align-items-center g-5 mb-5 pt-4">
            <div class="col-lg-7 order-lg-1">
                <p class="text-uppercase fw-bold mb-2" style="color:var(--azul);font-size:.85rem;letter-spacing:.1em;">
                    <i class="bi bi-clock-history me-1"></i>Cómo empezamos
                </p>
                <h2 class="seccion-titulo">Nuestra Historia</h2>
                <div class="linea-acento izquierda mb-4"></div>
                <div style="color:var(--texto-suave);font-size:1.05rem;line-height:1.85;">
                    <p>
                        AATEGRE Centro Diurno nació de la iniciativa de un grupo de vecinos de Grecia, Alajuela,
                        preocupados por el bienestar de los adultos mayores de la comunidad que pasaban gran parte
                        del día en soledad. Desde nuestros primeros pasos, apostamos por construir un espacio donde
                        cada persona mayor pudiera sentirse acompañada, útil y feliz.
                    </p>
                    <p class="mt-3">
                        Con el paso de los años hemos crecido gracias al apoyo de la comunidad, de instituciones
                        aliadas y del compromiso constante de nuestro equipo, consolidándonos como un referente de
                        cuidado diurno para personas adultas mayores en la zona.
                    </p>
                </div>
                <!--
                    borrador inicial sobre la historia del centro
                -->
            </div>
            <div class="col-lg-5 order-lg-2">
                <div class="quienes-imagen-wrap">
                    <img src="~/images/Centro-Diurno-Antes.jpg"
                         alt="Historia de AATEGRE Centro Diurno"
                         class="quienes-imagen-bg img-fluid rounded shadow">
                </div>
            </div>
        </div>

        @* imagenes del centro *@
        <div class="text-center mb-4 mt-5">
            <p class="text-uppercase fw-bold mb-2" style="color:var(--azul);font-size:.85rem;letter-spacing:.1em;">
                <i class="bi bi-images me-1"></i>Así somos
            </p>
            <h2 class="seccion-titulo">Un vistazo a nuestro Centro</h2>
            <div class="linea-acento mx-auto"></div>
        </div>

        @if (imagenesCarrusel != null && imagenesCarrusel.Any())
        {
            <div id="carouselQuienesSomos" class="carousel slide shadow rounded overflow-hidden mb-5" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @{
                        var idx = 0;
                    }
                    @foreach (var img in imagenesCarrusel)
                    {
                        <div class="carousel-item @(idx == 0 ? "active" : "")">
                            <img src="@img.ImagenBase64" class="d-block w-100"
                                 style="max-height:480px;object-fit:cover;" alt="@img.Titulo">
                            @if (!string.IsNullOrWhiteSpace(img.Titulo) || !string.IsNullOrWhiteSpace(img.Descripcion))
                            {
                                <div class="carousel-caption d-none d-md-block"
                                     style="background:rgba(0,0,0,0.45);border-radius:8px;bottom:1rem;">
                                    <h5 class="mb-0">@img.Titulo</h5>
                                    @if (!string.IsNullOrWhiteSpace(img.Descripcion))
                                    {
                                        <p class="mb-0 small">@img.Descripcion</p>
                                    }
                                </div>
                            }
                        </div>
                        idx++;
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselQuienesSomos" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselQuienesSomos" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        }
        else
        {
            <div class="estado-vacio mb-5">
                <i class="bi bi-images"></i>
                <h4>Galería del centro pendiente</h4>
                <p>Las fotos que se suban desde el panel administrativo (Imágenes) aparecerán aquí automáticamente.</p>
            </div>
        }

        <div class="text-center mb-5 mt-5">
            <h2 class="seccion-titulo">Nuestros Valores</h2>
            <div class="linea-acento mx-auto"></div>
        </div>
        <div class="row g-4 mb-5">
            <div class="col-sm-6 col-lg-3">
                <div class="servicio-card text-center">
                    <div class="servicio-icono-wrap servicio-icono-lila mx-auto"><i class="bi bi-heart-fill"></i></div>
                    <h5 class="servicio-titulo">Amor</h5>
                    <p class="servicio-desc">Actuamos desde el amor genuino hacia cada adulto mayor y su familia.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="servicio-card text-center">
                    <div class="servicio-icono-wrap servicio-icono-azul mx-auto"><i class="bi bi-shield-check"></i></div>
                    <h5 class="servicio-titulo">Respeto</h5>
                    <p class="servicio-desc">Honramos la historia, experiencia y dignidad de cada persona.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="servicio-card text-center">
                    <div class="servicio-icono-wrap servicio-icono-verde mx-auto"><i class="bi bi-stars"></i></div>
                    <h5 class="servicio-titulo">Excelencia</h5>
                    <p class="servicio-desc">Buscamos constantemente la mejora en cada servicio que ofrecemos.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="servicio-card text-center">
                    <div class="servicio-icono-wrap servicio-icono-naranja mx-auto"><i class="bi bi-people-fill"></i></div>
                    <h5 class="servicio-titulo">Comunidad</h5>
                    <p class="servicio-desc">Creamos lazos de amistad, pertenencia y apoyo mutuo.</p>
                </div>
            </div>
        </div>

        @* ───────── TRANSPARENCIA / PRESUPUESTO ───────── *@
        @if (imagenesPresupuesto != null && imagenesPresupuesto.Any())
        {
            <div class="text-center mb-4 mt-5">
                <p class="text-uppercase fw-bold mb-2" style="color:var(--azul);font-size:.85rem;letter-spacing:.1em;">
                    <i class="bi bi-file-earmark-bar-graph me-1"></i>Transparencia
                </p>
                <h2 class="seccion-titulo">Presupuesto Asignado por el Gobierno</h2>
                <div class="linea-acento mx-auto"></div>
                <p class="seccion-subtitulo mt-3">
                    En cumplimiento con nuestro compromiso de transparencia, compartimos el detalle del
                    presupuesto asignado al Centro Diurno.
                </p>
            </div>
            <div class="row g-4 justify-content-center mb-3">
                @foreach (var img in imagenesPresupuesto)
                {
                    <div class="col-md-8">
                        <div class="bg-white rounded-3 shadow-sm p-3 text-center">
                            <img src="@img.ImagenBase64" alt="@img.Titulo" class="img-fluid rounded" />
                            @if (!string.IsNullOrWhiteSpace(img.Titulo))
                            {
                                <p class="mt-3 mb-0 fw-semibold">@img.Titulo</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(img.Descripcion))
                            {
                                <p class="text-muted small mb-0">@img.Descripcion</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        @* Si no hay imagen de presupuesto cargada, esta sección simplemente no se muestra *@

        <div class="text-center mt-3">
            <a asp-controller="Home" asp-action="Contacto" class="btn-primario">
                <i class="bi bi-envelope-heart"></i>Contáctenos
            </a>
        </div>
    </div>
</section>
