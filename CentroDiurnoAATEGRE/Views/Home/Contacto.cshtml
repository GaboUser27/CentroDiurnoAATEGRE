@{
    ViewData["Title"] = "Contacto";
    ViewData["MetaDescription"] = "Contacte a AATEGRE Centro Diurno en Grecia, Alajuela: teléfono, correo, dirección, horario de atención y ubicación en el mapa.";
    ViewData["ActivePage"] = "Contacto";
    var info = ViewBag.Informacion;
}

<div class="pagina-hero-secundario">
    <div class="pagina-hero-curva"></div>
    <div class="container text-center position-relative">
        <div class="hero-eyebrow d-inline-flex mb-3">
            <i class="bi bi-envelope-heart me-2"></i>Estamos aquí para ayudarle
        </div>
        <h1>Información de Contacto</h1>
    </div>
</div>

<section class="seccion-contacto-detalle">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-5">
                <h2 class="seccion-titulo">Visítenos o escríbanos</h2>
                <div class="linea-acento izquierda mb-4"></div>
                <div class="d-flex flex-column gap-3 mt-4">
                    <div class="contacto-card">
                        <div class="contacto-icono ci-azul"><i class="bi bi-geo-alt-fill"></i></div>
                        <div>
                            <p class="contacto-info-titulo">Dirección</p>
                            <p class="contacto-info-dato">@(info?.Direccion ?? "Grecia, Alajuela, Costa Rica")</p>
                        </div>
                    </div>
                    <div class="contacto-card">
                        <div class="contacto-icono ci-lila"><i class="bi bi-telephone-fill"></i></div>
                        <div>
                            <p class="contacto-info-titulo">Teléfono</p>
                            <p class="contacto-info-dato">
                                <a href="tel:@(info?.Telefono ?? "+506 2444-3895")" style="color:var(--texto-suave);">
                                    @(info?.Telefono ?? "+506 2444-3895")
                                </a>
                            </p>
                        </div>
                    </div>
                    <div class="contacto-card">
                        <div class="contacto-icono ci-verde"><i class="bi bi-envelope-fill"></i></div>
                        <div>
                            <p class="contacto-info-titulo">Correo electrónico</p>
                            <p class="contacto-info-dato">
                                @if (!string.IsNullOrWhiteSpace(info?.Correo))
                                {
                                    <a href="mailto:@info?.Correo" style="color:var(--texto-suave);">@info?.Correo</a>
                                }
                                else
                                {
                                    <span>Correo no configurado</span>
                                }
                            </p>
                        </div>
                    </div>
                    <div class="contacto-card">
                        <div class="contacto-icono ci-naranja"><i class="bi bi-clock-fill"></i></div>
                        <div>
                            <p class="contacto-info-titulo">Horario de atención</p>
                            <p class="contacto-info-dato">Lunes a Viernes · 8:00 a.m. – 2:00 p.m.</p>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(info?.FacebookUrlSegura) || !string.IsNullOrWhiteSpace(info?.InstagramUrlSegura))
                {
                    <div class="mt-4 d-flex gap-2 flex-wrap">
                        @if (!string.IsNullOrWhiteSpace(info?.FacebookUrlSegura))
                        {
                            <a href="@info?.FacebookUrlSegura" target="_blank" rel="noopener noreferrer" class="rrss-btn fb">
                                <i class="bi bi-facebook"></i>Facebook
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(info?.InstagramUrlSegura))
                        {
                            <a href="@info?.InstagramUrlSegura" target="_blank" rel="noopener noreferrer" class="rrss-btn ig">
                                <i class="bi bi-instagram"></i>Instagram
                            </a>
                        }
                    </div>
                }
            </div>
            <div class="col-lg-7">
                <div class="mapa-contacto-wrap shadow-sm">
                    <iframe width="100%"
                            height="100%"
                            frameborder="0"
                            scrolling="no"
                            marginheight="0"
                            marginwidth="0"
                            src="https://maps.google.com/maps?q=Centro+Diurno+AATEGRE,+Costa+Rica&t=&z=16&ie=UTF8&iwloc=&output=embed"
                            style="border: 0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</section>
