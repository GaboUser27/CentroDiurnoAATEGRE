@{
    ViewData["Title"] = "Acceso Denegado";
    ViewData["MetaDescription"] = "No tiene permisos para acceder a esta sección del panel administrativo.";
}

<section style="min-height:60vh; display:flex; align-items:center; padding:5rem 0; background:var(--blanco);">
    <div class="container text-center">
        <div class="d-inline-flex align-items-center justify-content-center mb-4"
             style="width:110px;height:110px;border-radius:50%;background:#FDECEA;">
            <i class="bi bi-shield-lock-fill" style="font-size:3rem;color:#D32F2F;"></i>
        </div>

        <h1 style="font-family:'Playfair Display',serif;color:var(--azul-oscuro);font-size:clamp(1.6rem,4vw,2.4rem);">
            Acceso denegado
        </h1>
        <p class="mx-auto" style="max-width:520px;color:var(--texto-suave);font-size:1.05rem;">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <text>Su cuenta (<strong>@User.Identity.Name</strong>) no tiene el rol necesario para
                ver esta sección del panel administrativo. Si considera que esto es un error,
                contacte a un administrador del sistema.</text>
            }
            else
            {
                <text>Necesita iniciar sesión con una cuenta autorizada para ver esta página.</text>
            }
        </p>

        <div class="d-flex gap-3 justify-content-center flex-wrap mt-4">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Home" asp-action="Dashboard" class="btn-primario">
                    <i class="bi bi-grid-1x2 me-1"></i>Ir al panel
                </a>
            }
            else
            {
                <a asp-controller="Usuario" asp-action="Login" class="btn-primario">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
                </a>
            }
            <a asp-controller="Home" asp-action="Index" class="btn-secundario">
                <i class="bi bi-house-heart me-1"></i>Volver al inicio
            </a>
        </div>
    </div>
</section>
