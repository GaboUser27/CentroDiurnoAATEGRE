@model IEnumerable<CentroDiurnoAATEGRE.Application.DTOs.CategoriaImagenDTO>
@{
    ViewData["Title"] = "Categorías de Galería";
}

<div class="panel-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="badge-panel mb-2"><i class="bi bi-images me-1"></i>Gestión de Medios</span>
                <h1 class="mb-1"><i class="bi bi-folder2-open me-2"></i>Categorías de Galería</h1>
                <p class="mb-0">Organice y clasifique las imágenes y momentos para la galería pública.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Home" asp-action="Dashboard" class="btn-panel-secundario">
                    <i class="bi bi-arrow-left"></i>Panel
                </a>
                <a asp-controller="Imagen" asp-action="Index" class="btn-panel-secundario">
                    <i class="bi bi-images"></i>Galería
                </a>
                <a asp-action="Crear" class="btn-panel-primario">
                    <i class="bi bi-folder-plus"></i>Nueva Categoría
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-aategre alert-success-custom d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Exito"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-aategre alert-danger-custom d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var cat in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="categoria-admin-card h-100">
                        <div class="categoria-admin-header">
                            <div class="categoria-icon-box">
                                <i class="bi bi-folder2-open"></i>
                            </div>
                            <div class="categoria-info">
                                <h5 class="categoria-titulo" title="@cat.Nombre">@cat.Nombre</h5>
                                <span class="badge-conteo">
                                    <i class="bi bi-images me-1"></i>@(cat.Imagen?.Count ?? 0) @((cat.Imagen?.Count ?? 0) == 1 ? "imagen" : "imágenes")
                                </span>
                            </div>
                        </div>

                        <div class="categoria-admin-body">
                            <p class="categoria-desc">
                                @(string.IsNullOrWhiteSpace(cat.Descripcion) ? "Sin descripción asignada para esta categoría." : cat.Descripcion)
                            </p>
                        </div>

                        <div class="categoria-admin-footer">
                            <a asp-controller="Imagen" asp-action="Galeria"
                               asp-route-categoriaId="@cat.IdCategoriaImagen"
                               class="btn-accion-publica" title="Ver en galería pública">
                                <i class="bi bi-eye"></i><span>Ver en sitio</span>
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-action="Editar" asp-route-id="@cat.IdCategoriaImagen"
                                   class="btn-accion-icono editar" title="Editar categoría">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-action="Eliminar" asp-route-id="@cat.IdCategoriaImagen"
                                   class="btn-accion-icono eliminar"
                                   onclick="return confirm('¿Está seguro de eliminar esta categoría?');"
                                   title="Eliminar categoría">
                                    <i class="bi bi-trash3-fill"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="estado-vacio-moderno text-center py-5">
                    <div class="estado-vacio-icono mb-3">
                        <i class="bi bi-folder-x"></i>
                    </div>
                    <h4>No hay categorías registradas</h4>
                    <p class="text-muted mb-4">Comience organizando las actividades del centro creando su primera categoría.</p>
                    <a asp-action="Crear" class="btn-primario">
                        <i class="bi bi-folder-plus"></i>Crear primera categoría
                    </a>
                </div>
            </div>
        }
    </div>
</div>