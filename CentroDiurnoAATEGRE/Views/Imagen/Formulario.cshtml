@using CentroDiurnoAATEGRE.Application.DTOs
@model ImagenDTO
@{
    bool esEdicion = Model.IdImagen > 0;
    ViewData["Title"] = esEdicion ? "Editar Imagen" : "Agregar Imágenes a la Galería";
}

<div class="panel-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <a asp-action="Index" class="btn-panel-secundario" title="Volver al listado">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <span class="badge-panel mb-2"><i class="bi bi-images me-1"></i>Galería Institucional</span>
                    <h1 class="mb-0">
                        <i class="bi bi-@(esEdicion ? "pencil-square" : "cloud-arrow-up-fill") me-2"></i>@ViewData["Title"]
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-9">
            <div class="form-card-aategre">
                <div class="form-card-header mb-4">
                    <h4 class="form-card-title">
                        <i class="bi bi-card-image text-primary me-2"></i>Información de la Carga
                    </h4>
                    <p class="form-card-sub">
                        @(esEdicion 
                            ? "Modifique los datos o reemplace la imagen actual." 
                            : "Seleccione una o varias fotografías y asócielas a una categoría de actividades.")
                    </p>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-aategre alert-danger-custom d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@TempData["Error"]</div>
                    </div>
                }

                <form method="post" enctype="multipart/form-data"
                      asp-action="@(esEdicion ? "Editar" : "Crear")"
                      asp-route-id="@Model.IdImagen" id="formImagen">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdImagen" />

                    @* Si es edición y ya tiene imagen *@
                    @if (esEdicion && Model.ImagenBase64 != null)
                    {
                        <div class="imagen-actual-box mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge-conteo"><i class="bi bi-image me-1"></i>Imagen Actual</span>
                            </div>
                            <div class="text-center">
                                <img src="@Model.ImagenBase64" alt="@Model.Titulo" class="imagen-actual-preview" />
                            </div>
                        </div>
                    }

                    <!-- Zona Dropzone de Carga -->
                    <div class="mb-4">
                        <label class="form-label-moderno">
                            <i class="bi bi-cloud-upload-fill text-primary"></i>
                            <span>@(esEdicion ? "Reemplazar fotografía (opcional)" : "Fotografías a subir *")</span>
                        </label>

                        <div class="dropzone-aategre" id="dropzone">
                            <div class="dropzone-icon">
                                <i class="bi bi-cloud-arrow-up-fill"></i>
                            </div>
                            <h5 class="dropzone-title">
                                Arrastra tus fotos aquí o <span class="dropzone-link">haz clic para examinar</span>
                            </h5>
                            <p class="dropzone-hint">
                                Admite selección múltiple de imágenes (JPG, PNG, WebP, GIF)
                            </p>
                            <input type="file" id="archivos" name="archivos" class="d-none"
                                   accept="image/jpeg,image/png,image/webp,image/gif"
                                   @(esEdicion ? "" : "multiple required") />
                        </div>
                        <span asp-validation-for="Imagen1" class="text-danger small mt-1 d-block"></span>

                        <!-- Contenedor de Previsualizaciones -->
                        <div id="previewContainer" class="preview-container mt-3" style="display:none;">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span id="previewCount" class="badge-conteo"></span>
                                <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none" onclick="limpiarSeleccion()">
                                    <i class="bi bi-trash3 me-1"></i>Quitar todas
                                </button>
                            </div>
                            <div id="previewGrid" class="preview-grid"></div>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-7">
                            <label class="form-label-moderno" asp-for="Titulo">
                                <i class="bi bi-fonts text-primary"></i>
                                <span>Título o Actividad *</span>
                            </label>
                            <input asp-for="Titulo" class="form-control-moderno"
                                   placeholder="Ej: Taller de Arte y Manualidades" maxlength="150" required />
                            <small class="text-muted d-block mt-1">
                                Si subes varias fotos, este título identificará al grupo de imágenes.
                            </small>
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label-moderno" asp-for="IdCategoriaImagen">
                                <i class="bi bi-folder2-open text-primary"></i>
                                <span>Categoría *</span>
                            </label>
                            <select asp-for="IdCategoriaImagen" asp-items="ViewBag.Categorias"
                                    class="form-select-moderno" required>
                                <option value="">— Seleccione categoría —</option>
                            </select>
                            <span asp-validation-for="IdCategoriaImagen" class="text-danger small"></span>
                        </div>

                        <div class="col-md-7">
                            <label class="form-label-moderno" asp-for="Descripcion">
                                <i class="bi bi-text-paragraph text-primary"></i>
                                <span>Descripción <span class="text-muted fw-normal">(opcional)</span></span>
                            </label>
                            <textarea asp-for="Descripcion" class="form-control-moderno" rows="3"
                                      placeholder="Agregue detalles o contexto de la actividad realizada..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label-moderno" asp-for="FechaImagen">
                                <i class="bi bi-calendar-event text-primary"></i>
                                <span>Fecha de la Actividad *</span>
                            </label>
                            <input asp-for="FechaImagen" type="date" class="form-control-moderno" required />
                            <span asp-validation-for="FechaImagen" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-card-footer d-flex align-items-center justify-content-end gap-3 pt-3">
                        <a asp-action="Index" class="btn-form-cancelar">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn-form-guardar" id="btnSubmit">
                            <i class="bi bi-@(esEdicion ? "check-circle-fill" : "cloud-arrow-up-fill") me-2"></i>
                            @(esEdicion ? "Guardar cambios" : "Subir a la galería")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const esEdicion = @(esEdicion ? "true" : "false");
        let dt = new DataTransfer();
        const inputArchivos = document.getElementById('archivos');
        const dropzone = document.getElementById('dropzone');
        const previewContainer = document.getElementById('previewContainer');
        const previewGrid = document.getElementById('previewGrid');
        const previewCount = document.getElementById('previewCount');

        function actualizarPreviews() {
            previewGrid.innerHTML = '';
            if (dt.files.length === 0) {
                previewContainer.style.display = 'none';
                return;
            }

            previewContainer.style.display = 'block';
            previewCount.innerHTML = esEdicion
                ? `<i class="bi bi-arrow-repeat me-1"></i>Nueva imagen seleccionada para reemplazar`
                : `<i class="bi bi-images me-1"></i>${dt.files.length} ${dt.files.length === 1 ? 'imagen seleccionada' : 'imágenes seleccionadas'}`;

            Array.from(dt.files).forEach((file, index) => {
                const card = document.createElement('div');
                card.className = 'preview-card';

                const img = document.createElement('img');
                img.className = 'preview-card-img';
                img.src = URL.createObjectURL(file);

                const info = document.createElement('div');
                info.className = 'preview-card-info';

                const name = document.createElement('span');
                name.className = 'preview-card-name';
                name.textContent = file.name;
                name.title = file.name;

                const size = document.createElement('span');
                size.className = 'preview-card-size';
                const sizeKB = (file.size / 1024).toFixed(0);
                size.textContent = sizeKB > 1024 ? (file.size / (1024 * 1024)).toFixed(1) + ' MB' : sizeKB + ' KB';

                info.appendChild(name);
                info.appendChild(size);

                const btnRemove = document.createElement('button');
                btnRemove.type = 'button';
                btnRemove.className = 'preview-card-remove';
                btnRemove.title = 'Quitar esta imagen';
                btnRemove.innerHTML = '<i class="bi bi-x-lg"></i>';
                btnRemove.onclick = (e) => {
                    e.stopPropagation();
                    removerArchivo(index);
                };

                card.appendChild(img);
                card.appendChild(info);
                card.appendChild(btnRemove);
                previewGrid.appendChild(card);
            });
        }

        function agregarArchivos(archivosNuevos) {
            if (esEdicion) {
                dt = new DataTransfer(); // en edición se reemplaza
            }
            for (let i = 0; i < archivosNuevos.length; i++) {
                const f = archivosNuevos[i];
                if (f.type.startsWith('image/')) {
                    dt.items.add(f);
                    if (esEdicion) break; // en edición solo se toma 1
                }
            }
            inputArchivos.files = dt.files;
            actualizarPreviews();
        }

        function removerArchivo(index) {
            const nuevoDt = new DataTransfer();
            Array.from(dt.files).forEach((f, i) => {
                if (i !== index) nuevoDt.items.add(f);
            });
            dt = nuevoDt;
            inputArchivos.files = dt.files;
            actualizarPreviews();
        }

        function limpiarSeleccion() {
            dt = new DataTransfer();
            inputArchivos.files = dt.files;
            actualizarPreviews();
        }

        if (dropzone) {
            dropzone.addEventListener('click', () => inputArchivos.click());

            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.add('dropzone-active');
                });
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.remove('dropzone-active');
                });
            });

            dropzone.addEventListener('drop', (e) => {
                if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                    agregarArchivos(e.dataTransfer.files);
                }
            });

            inputArchivos.addEventListener('change', () => {
                if (inputArchivos.files && inputArchivos.files.length > 0) {
                    agregarArchivos(inputArchivos.files);
                }
            });
        }
    </script>
}