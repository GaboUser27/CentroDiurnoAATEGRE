@model CentroDiurnoAATEGRE.Application.DTOs.InformacionInstitucionalDTO?

@if (!string.IsNullOrWhiteSpace(Model?.FacebookUrlSegura))
{
    <a href="@Model.FacebookUrlSegura" target="_blank" rel="noopener noreferrer"
       class="rrss-btn fb" aria-label="Facebook de AATEGRE Centro Diurno (se abre en una pestaña nueva)">
        <i class="bi bi-facebook"></i> Facebook
    </a>
}
@if (!string.IsNullOrWhiteSpace(Model?.InstagramUrlSegura))
{
    <a href="@Model.InstagramUrlSegura" target="_blank" rel="noopener noreferrer"
       class="rrss-btn ig" aria-label="Instagram de AATEGRE Centro Diurno (se abre en una pestaña nueva)">
        <i class="bi bi-instagram"></i> Instagram
    </a>
}
@if (string.IsNullOrWhiteSpace(Model?.FacebookUrlSegura) && string.IsNullOrWhiteSpace(Model?.InstagramUrlSegura))
{
    <span class="footer-rrss-vacio">Redes sociales próximamente</span>
}
