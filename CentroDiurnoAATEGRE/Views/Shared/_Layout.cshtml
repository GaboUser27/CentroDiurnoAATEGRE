@{
    // Valores por defecto de SEO para todo el sitio. Cualquier vista puede
    // sobreescribirlos así, ANTES del @{...} que llama a RenderBody, ej:
    //   ViewData["Title"] = "Quiénes Somos";
    //   ViewData["MetaDescription"] = "Conozca la historia de AATEGRE...";
    var metaTitulo = ViewData["Title"] != null
        ? $"{ViewData["Title"]} — AATEGRE Centro Diurno"
        : "AATEGRE Centro Diurno — Cuidado integral para adultos mayores";
    var metaDescripcion = ViewData["MetaDescription"] as string
        ?? "AATEGRE Centro Diurno brinda cuidado integral, actividades y calidez humana para adultos mayores en Grecia, Alajuela, Costa Rica.";
    var metaUrlBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var metaUrlActual = $"{metaUrlBase}{Context.Request.Path}";
    var metaImagen = $"{metaUrlBase}/images/logo_AATEGRE-sin-fondo.png";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@metaTitulo</title>

    <!-- SEO básico -->
    <meta name="description" content="@metaDescripcion" />
    <meta name="keywords" content="centro diurno, adultos mayores, cuidado de adultos mayores, Grecia, Alajuela, Costa Rica, AATEGRE, hogar de día" />
    <meta name="author" content="AATEGRE Centro Diurno" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@metaUrlActual" />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@metaTitulo" />
    <meta property="og:description" content="@metaDescripcion" />
    <meta property="og:image" content="@metaImagen" />
    <meta property="og:url" content="@metaUrlActual" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:site_name" content="AATEGRE Centro Diurno" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@metaTitulo" />
    <meta name="twitter:description" content="@metaDescripcion" />
    <meta name="twitter:image" content="@metaImagen" />

    <meta name="theme-color" content="#1A4A8A" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/logo AATEGRE.png" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-aategre">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo AATEGRE.png" alt="Logo AATEGRE" />
                <div class="brand-text">
                    <span class="brand-nombre">AATEGRE</span>
                    <span class="brand-subtitulo">Centro Diurno</span>
                </div>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarMain" aria-label="Abrir menú">
                <i class="bi bi-list fs-2 text-primary"></i>
            </button>

            <div class="collapse navbar-collapse navbar-menu-panel" id="navbarMain">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Index" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-heart me-1"></i>Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Quienes" ? "active" : "")"
                           asp-controller="Home" asp-action="QuienesSomos">
                            <i class="bi bi-people me-1"></i>Quiénes Somos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Actividades" ? "active" : "")"
                           asp-controller="Imagen" asp-action="Galeria">
                            <i class="bi bi-images me-1"></i>Actividades
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Avisos" ? "active" : "")"
                           asp-controller="Home" asp-action="Avisos">
                            <i class="bi bi-megaphone me-1"></i>Avisos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Contacto" ? "active" : "")"
                           asp-controller="Home" asp-action="Contacto">
                            <i class="bi bi-envelope-heart me-1"></i>Contacto
                        </a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <a class="btn-secundario dropdown-toggle d-inline-flex align-items-center"
                                   href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-2"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius:12px; min-width:190px;">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="Dashboard">
                                            <i class="bi bi-grid-1x2 me-2 text-primary"></i>Panel
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Usuario" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn-primario" asp-controller="Usuario" asp-action="Login">
                                <i class="bi bi-lock me-1"></i>Acceso Administrativo
                            </a>
                        }
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer-aategre">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-logo">
                        <img src="~/images/logo_AATEGRE-sin-fondo.png" alt="AATEGRE Centro Diurno" />
                    </div>
                    <span class="footer-nombre">AATEGRE Centro Diurno</span>
                    <p class="footer-slogan">Cuidado integral con calidez humana para nuestros adultos mayores.</p>
                    <div class="mt-3 d-flex gap-2 flex-wrap">
                        @await Component.InvokeAsync("FooterInfo")
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 col-sm-6">
                    <h6 class="footer-titulo">Navegación</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right"></i>Inicio</a></li>
                        <li><a asp-controller="Home" asp-action="QuienesSomos"><i class="bi bi-chevron-right"></i>Quiénes Somos</a></li>
                        <li><a asp-controller="Imagen" asp-action="Galeria"><i class="bi bi-chevron-right"></i>Actividades</a></li>
                        <li><a asp-controller="Home" asp-action="Avisos"><i class="bi bi-chevron-right"></i>Avisos</a></li>
                        <li><a asp-controller="Home" asp-action="Contacto"><i class="bi bi-chevron-right"></i>Contacto</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="footer-titulo">Información de Contacto</h6>
                    <div class="footer-dato"><i class="bi bi-geo-alt-fill"></i><span>Grecia, Alajuela, Costa Rica</span></div>
                    <div class="footer-dato"><i class="bi bi-telephone-fill"></i><span>+506 2494-XXXX</span></div>
                    <div class="footer-dato"><i class="bi bi-envelope-fill"></i><span>info@@aategre.cr</span></div>
                    <div class="footer-dato"><i class="bi bi-clock-fill"></i><span>Lunes a Viernes · 7:00 a.m. – 4:00 p.m.</span></div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p class="mb-0">&copy; @DateTime.Now.Year AATEGRE Centro Diurno — Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Datos estructurados (Schema.org) para que Google entienda de qué
         trata el sitio y pueda mostrarlo mejor en los resultados de búsqueda. -->
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "NursingHome",
            "name": "AATEGRE Centro Diurno",
            "description": "Centro diurno de cuidado integral para adultos mayores en Grecia, Alajuela, Costa Rica.",
            "url": "@metaUrlBase",
            "logo": "@metaImagen",
            "image": "@metaImagen",
            "address": {
                "@@type": "PostalAddress",
                "addressLocality": "Grecia",
                "addressRegion": "Alajuela",
                "addressCountry": "CR"
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
