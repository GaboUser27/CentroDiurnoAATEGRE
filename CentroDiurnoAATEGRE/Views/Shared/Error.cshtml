@{
    ViewData["Title"] = "Error";
    var codigoError = ViewData["CodigoError"] as int?;

    // Colores extraídos de la paleta institucional
    var azulInstitucional = "#0a5699";
    var rosaInstitucional = "#c1759d";
}

<main class="container-fluid bg-white d-flex flex-column justify-content-center align-items-center" style="min-height: 100vh; margin: -1rem 0;">
    <div class="text-center" style="max-width: 600px;">

        <!-- Signo de pregunta -->
        <div class="d-flex justify-content-center align-items-center mx-auto rounded-circle mb-4 shadow"
             style="width: 120px; height: 120px; background-color: @azulInstitucional; color: white; font-size: 5rem; font-weight: bold;">
            ?
        </div>

        <!-- Código de Error -->
        <div class="display-1 fw-bold" style="letter-spacing: -2px; color: @rosaInstitucional;">
            @(codigoError == 404 ? "404" : "500")
        </div>

        <h2 class="h3 mb-4 text-secondary">
            @(codigoError == 404 ? "Ruta no encontrada" : "Fallo interno del sistema")
        </h2>

        <!-- Caja de detalles estilo consola -->
        <div class="p-4 rounded-3 mb-5 text-start font-monospace fs-6 bg-light border">
            <span style="color: @azulInstitucional; font-weight: bold;">>_ </span> <span class="text-dark">Solicitud interrumpida.</span><br>
            <span style="color: @azulInstitucional; font-weight: bold;">>_ </span> <span class="text-dark">@(codigoError == 404 ? "Verifique la URL ingresada." : "El equipo técnico ha sido notificado.")</span>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-lg px-5 text-white fw-bold shadow-sm" style="background-color: @rosaInstitucional; border-radius: 50px;">
            Volver al Inicio
        </a>

    </div>
</main>